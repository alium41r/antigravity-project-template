# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES REFERENCE
# Configure these variables in your hosting platform (Vercel, Railway, AWS, etc.).
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# Supabase Production Project Keys
NEXT_PUBLIC_SUPABASE_URL="https://<prod-project-id>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<prod-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<prod-service-role-key>"

# Database Connection (Supabase Transaction Pooler recommended for serverless)
DIRECT_URL="postgresql://postgres:[password]@db.<prod-project-id>.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:[password]@db.<prod-project-id>.supabase.co:6543/postgres?pgbouncer=true"

# Production Secrets
# APP_SECRET="<cryptographically-secure-random-string>"
# ENCRYPTION_KEY="<32-byte-hex-string>"
