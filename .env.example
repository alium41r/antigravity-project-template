# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# Next.js Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Public (Client-safe - exposed to browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server (Confidential - server-side runtime only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (PostgreSQL Connection Strings)
# Direct connection to the database (used by Prisma for introspection via `prisma db pull`)
# Local Supabase direct PostgreSQL port is 54322 (defined in supabase/config.toml [db.port])
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Connection pooler / application runtime URL (used by Prisma Client at runtime)
# NOTE: The local pooler is DISABLED by default in supabase/config.toml ([db.pooler.enabled = false]).
# - Local dev default: points directly to port 54322 (same as DIRECT_URL).
# - Local dev with pooler enabled: points to port 54329 (supabase/config.toml [db.pooler.port]).
# - Production (Supabase cloud): points to transaction pooler port 6543 (?pgbouncer=true).
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Application Secrets (Optional / As Needed)
# APP_SECRET="generate-a-secure-random-secret"
# ENCRYPTION_KEY="32-byte-hex-key"

# Third-Party Integrations (Optional / Fill per project requirements)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RESEND_API_KEY=""
